sysinfo.txt

# Local verification output. Keep the folder placeholders in Git; release
# artifacts in Artifacts/Releases remain versioned.
/Artifacts/Logs/*
!/Artifacts/Logs/.gitkeep
/Artifacts/TestResults/*
!/Artifacts/TestResults/.gitkeep
