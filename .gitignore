crashlytics-build.properties

# Packed Addressables
[Aa]ssets/[Aa]ddressable[Aa]ssets/D[a]ta/*/*.bin*
[Aa]ssets/[Aa]ddressable[Aa]ssets/D[a]ta/*/*.bin*.meta

# Legacy local test output at the repository root
/EditModeTestResults-*.xml
/test-results.xml
/unity-*.log

# Local verification output. Keep the folder placeholders in Git; release
# artifacts in Artifacts/Releases remain versioned.
/Artifacts/Logs/*
!/Artifacts/Logs/.gitkeep
/Artifacts/TestResults/*
!/Artifacts/TestResults/.gitkeep
