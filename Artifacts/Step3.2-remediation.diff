+            buffer.CaptureTick(12, world);
+            buffer.Advance(TickSeconds);
+            Assert.That(buffer.TrySample(0, out var after), Is.True);
+            Assert.That(
+                after.HealthFraction,
+                Is.EqualTo(50f / 123f).Within(1e-6f),
